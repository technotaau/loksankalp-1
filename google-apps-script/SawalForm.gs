/* "नशे पर आपका सवाल" : Google Form एक बार में बना देने वाली लिपि
 *
 * यह लोकसंकल्प की चालू सेवा (Code.gs) का हिस्सा नहीं है और उससे अलग रखी गई
 * है। कारण यह कि फ़ॉर्म बनाने के लिए Google से नई अनुमति माँगनी पड़ती है, और
 * वह अनुमति चालू Code.gs में जोड़ने पर उसका web app दोबारा अधिकृत कराना
 * पड़ता, यानी चलती हुई सेवा को छेड़ना पड़ता। इसे अलग रखने से वह ख़तरा ही नहीं
 * रहता।
 *
 * चलाने का तरीक़ा docs/SAWAL-FORM.md में लिखा है। एक बार चलती है, बस।
 *
 * मसौदा : docs/SAWAL-FORM.md. वहाँ का पाठ और यहाँ का पाठ एक ही रहें।
 */

/* संकट में फ़ोन करने का नंबर। खाली छोड़ा है, जान-बूझकर।
 *
 * यह फ़ॉर्म नशे पर सवाल माँगता है, इसलिए इसमें संकट के संदेश भी आएँगे : कोई
 * माँ लिखेगी कि बेटा हाथ से निकल चुका है, कोई लिखेगा कि अब जीने का मन नहीं।
 * फ़ॉर्म जवाब नहीं दे सकता, इसलिए उस आदमी के पास फ़ोन करने को एक नंबर होना
 * चाहिए।
 *
 * नंबर भरे बिना यह लिपि चलने से इनकार कर देती है। यह रोक हटाइए मत : बिना
 * नंबर वाला फ़ॉर्म बाहर चला जाए तो उसे वापस नहीं लाया जा सकता, और जिसने
 * संकट में लिखा वह चुपचाप बिना जवाब रह जाएगा।
 *
 * नई किरण का अपना नंबर सबसे अच्छा है। भारत सरकार की नशा मुक्ति हेल्पलाइन
 * 14446 भी रखी जा सकती है, पर उसे पहले ख़ुद फ़ोन करके जाँचिए कि वह उठता है
 * और हिंदी में बात होती है। बिना जाँचा नंबर छापना न छापने से बुरा है।
 */
var PHONE = '';

/* जिलों की सूची tools/districts.txt से। वही 41, वही वर्तनी, वही क्रम,
   जो वेबसाइट के बाकी सब फ़ॉर्मों में है। */
var JILE = [
  'अजमेर',
  'अलवर',
  'उदयपुर',
  'करौली',
  'कोटपूतली-बहरोड़',
  'कोटा',
  'खैरथल-तिजारा',
  'चित्तौड़गढ़',
  'चूरू',
  'जयपुर',
  'जालौर',
  'जैसलमेर',
  'जोधपुर',
  'झालावाड़',
  'झुंझुनू',
  'टोंक',
  'डीग',
  'डीडवाना-कुचामन',
  'डूंगरपुर',
  'दौसा',
  'धौलपुर',
  'नागौर',
  'पाली',
  'प्रतापगढ़',
  'फलौदी',
  'बांसवाड़ा',
  'बाड़मेर',
  'बारां',
  'बालोतरा',
  'बीकानेर',
  'बूंदी',
  'ब्यावर',
  'भरतपुर',
  'भीलवाड़ा',
  'राजसमंद',
  'श्रीगंगानगर',
  'सलूम्बर',
  'सवाई माधोपुर',
  'सिरोही',
  'सीकर',
  'हनुमानगढ़'
];

function banaoSawalForm() {
  if (!String(PHONE).trim()) {
    throw new Error('पहले ऊपर PHONE में संकट के समय फ़ोन करने का नंबर भरिए। ' +
                    'बिना नंबर के यह फ़ॉर्म नहीं बनेगा।');
  }

  var form = FormApp.create('नशे पर आपका सवाल');
  form.setDescription(
    'नशे को लेकर आपके मन में जो सवाल है, वह यहाँ लिखिए।\n\n' +
    'गाँव-गाँव से आए ऐसे सवालों के जवाब नई किरण नशा मुक्ति केंद्र के ' +
    'परामर्शदाता तैयार करेंगे। वे जवाब loksankalp.org पर सबके लिए रखे ' +
    'जाएँगे, ताकि जो बात आप पूछ रहे हैं वह और हज़ारों लोगों के काम आए।\n\n' +
    'नाम और मोबाइल नंबर नहीं पूछे जाते। आप कौन हैं, यह हमें पता नहीं चलेगा।' +
    '\n\n' +
    'यह हेल्पलाइन नहीं है। यहाँ लिखे सवाल का जवाब तुरंत नहीं आता और किसी को ' +
    'फ़ोन नहीं किया जाता। अगर अभी किसी से बात करनी है, या किसी की जान का ' +
    'ख़तरा है, तो ' + PHONE + ' पर फ़ोन कीजिए।'
  );

  /* पहला सवाल, अकेला ज़रूरी। कम से कम दस अक्षर की जाँच इसलिए कि बिना इसके
     शीट में "hi" और "." जैसी पंक्तियाँ भरती रहती हैं, और उन्हें छाँटने में
     जवाब लिखने से ज़्यादा समय लगता है। */
  form.addParagraphTextItem()
    .setTitle('आपका सवाल')
    .setHelpText('जैसे मन में आए वैसे लिखिए। भाषा सुंदर होना ज़रूरी नहीं है। एक-दो पंक्ति भी काफ़ी है।')
    .setRequired(true)
    .setValidation(
      FormApp.createParagraphTextValidation()
        .setHelpText('कृपया अपना सवाल थोड़ा और लिखिए।')
        .requireTextLengthGreaterThanOrEqualTo(10)
        .build()
    );

  form.addParagraphTextItem()
    .setTitle('दूसरा सवाल (अगर हो तो)')
    .setHelpText('एक से ज़्यादा सवाल हों तो यहाँ लिखिए। न हो तो छोड़ दीजिए।')
    .setRequired(false);

  form.addParagraphTextItem()
    .setTitle('तीसरा सवाल (अगर हो तो)')
    .setRequired(false);

  /* यह खाना सबसे ज़्यादा काम का है। "शराब कैसे छुड़ाएँ" का जवाब उस आदमी के
     लिए और है जो ख़ुद पीता है, और उस औरत के लिए बिल्कुल और जिसका पति पीता
     है। एक ही सवाल, दो अलग जवाब। एक टैप यहाँ, घंटों की बचत वहाँ। */
  form.addMultipleChoiceItem()
    .setTitle('यह सवाल किसके बारे में है?')
    .setChoiceValues([
      'अपने बारे में',
      'परिवार के किसी सदस्य के बारे में',
      'दोस्त या जान-पहचान के किसी व्यक्ति के बारे में',
      'गाँव या मोहल्ले के बारे में',
      'मैं शिक्षक, कार्यकर्ता या समाजसेवी हूँ, काम के लिए पूछ रहा हूँ',
      'बताना नहीं चाहता / चाहती'
    ])
    .setRequired(false);

  form.addCheckboxItem()
    .setTitle('किस नशे से जुड़ा सवाल है?')
    .setChoiceValues([
      'शराब',
      'तंबाकू, गुटखा, पान मसाला',
      'बीड़ी, सिगरेट',
      'अफ़ीम, डोडा-पोस्त',
      'स्मैक, चिट्टा, हेरोइन',
      'भांग, गांजा',
      'नशे की गोलियाँ या सिरप',
      'इंजेक्शन से लिया जाने वाला नशा',
      'किसी ख़ास नशे का नहीं, आम सवाल है',
      'पता नहीं'
    ])
    .setRequired(false);

  form.addListItem()
    .setTitle('आपका जिला')
    .setHelpText('सिर्फ़ यह जानने के लिए कि सवाल कहाँ-कहाँ से आ रहे हैं। यह ज़रूरी नहीं है।')
    .setChoiceValues(JILE.concat(['राजस्थान से बाहर']))
    .setRequired(false);

  /* सेटिंग।

     ईमेल न माँगना और "एक आदमी एक बार" बंद रखना, दोनों एक ही कारण से हैं :
     चालू करने पर Google लॉगिन माँगता है, और जिस आदमी के फ़ोन में Gmail नहीं
     है वह सवाल ही नहीं पूछ पाएगा। वही आदमी जिसके लिए यह सेवा बन रही है।

     सबका जोड़ (summary) भी बंद है : ये सवाल निजी हैं, भेजने वाले को बाकी
     सबके सवाल नहीं दिखने चाहिए। */
  form.setCollectEmail(false);
  form.setLimitOneResponsePerUser(false);
  form.setAllowResponseEdits(false);
  form.setPublishingSummary(false);
  form.setProgressBar(false);
  form.setShuffleQuestions(false);
  form.setShowLinkToRespondAgain(true);
  form.setConfirmationMessage(
    'आपका सवाल मिल गया। धन्यवाद।\n\n' +
    'जवाब नई किरण नशा मुक्ति केंद्र के परामर्शदाता तैयार करेंगे और वे ' +
    'loksankalp.org पर सबके लिए रखे जाएँगे। आपको यहाँ अलग से कोई जवाब नहीं ' +
    'भेजा जाएगा, क्योंकि हमने आपका नंबर लिया ही नहीं।\n\n' +
    'अगर अभी किसी से बात करनी है तो ' + PHONE + ' पर फ़ोन कीजिए। बात गोपनीय ' +
    'रहती है।\n\n' +
    'एक और सवाल पूछना हो तो नीचे दिए लिंक से भेज दीजिए।'
  );

  // जवाब सीधे एक नई स्प्रेडशीट में जाएँ
  var sheet = SpreadsheetApp.create('नशे पर आए सवाल');
  form.setDestination(FormApp.DestinationType.SPREADSHEET, sheet.getId());

  Logger.log('फ़ॉर्म बन गया।');
  Logger.log('लोगों को यह लिंक भेजिए : ' + form.getPublishedUrl());
  Logger.log('बदलने के लिए यह खोलिए  : ' + form.getEditUrl());
  Logger.log('जवाब यहाँ आएँगे        : ' + sheet.getUrl());
  Logger.log('');
  Logger.log('अब दो काम हाथ से करने बाक़ी हैं, ये लिपि से नहीं होते :');
  Logger.log('1. फ़ॉर्म के Responses में जाकर "Get email notifications for');
  Logger.log('   new responses" चालू कीजिए, ताकि हर सवाल किसी के इनबॉक्स में');
  Logger.log('   अपने आप पहुँचे और शीट खोलना याद रखना न पड़े।');
  Logger.log('2. शीट में सात स्तंभ जोड़िए, जैसा docs/SAWAL-FORM.md में लिखा');
  Logger.log('   है। सबसे पहला "ख़तरा" वाला, रंग लगाकर।');
}
